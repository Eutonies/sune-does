@page "/blocks"
@inherits MasterPage

<div class="sundo-blocks-container container-fluid">
    @if (_currentChapter != null)
    {
        <div class="sundo-blocks-block-container" @onclick="@(() => OnChapterSelectionChanged(null))">

            @foreach (var (pag, order) in Pages.Select((pag, indx) => (pag, indx)))
            {
                <BlocksPageComponent Order="order"
                Title="@pag.Title"
                Index="pag.Index"
                Content="pag.Content"
                PageNumber="(pag.Index + 1)"
                TotalNumberOfPages="Pages.Count"
                OnClickLeft="@(ClickLeftHandlerFor(pag))"
                OnClickRight="@(ClickRightHandlerFor(pag))"></BlocksPageComponent>
            }
        </div>
    }
    <div class="sundo-blocks-map-container">
        <BlocksMapComponent 
            OnChapterChanged="OnChapterSelectionChanged"
            AllChapters="AllChapters"
        ></BlocksMapComponent>
    </div>
</div>

