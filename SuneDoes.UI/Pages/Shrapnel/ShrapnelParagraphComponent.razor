<div class="sunedoes-shrapnel-paragraph-component @(IsEven ? "par-even" : "par-odd")">
    <div class="sunedoes-shrapnel-paragraph-lines container-fluids">
        @foreach(var lin in Paragraph.Lines) {
            <div class="row stick-down">
                @if(lin.IsJen) {
                    <div class="col-2 jen-name">@lin.SaidBy</div>
                    <div class="col-6 jen-line">@lin.Line</div>
                    <div class="col-4"></div>
                }
                else if(lin.IsWill) {
                    <div class="col-4"></div>
                    <div class="col-6 will-line">@lin.Line</div>
                    <div class="col-2 will-name">@lin.SaidBy</div>
                }
                else {
                    <h1>@(lin.Line)</h1>
                }
            </div>
            @if(lin.Description != null) {
                <div class="row stick-up">
                    @if(lin.IsJen) {
                        <div class="col-2"></div>
                        <div class="col-6 jen-description">@lin.Description</div>
                        <div class="col-4"></div>
                    }
                    else if(lin.IsWill) {
                        <div class="col-4"></div>
                        <div class="col-6 will-description">@lin.Description</div>
                        <div class="col-2"></div>
                    }
                </div>
            }
        }
    </div>
</div>