@page "/space-and-time"
@using Booktex.Html.Story
@using SuneDoes.UI.Pages.OnlineDating.Apps
@inherits MasterPage

@if(_recordToDisplay != null) 
{
    <div class="sundo-space-story-bg" @onclick="(() => OnCloseClicked())">
        <div class="sundo-space-story-container" @onclick:stopPropagation>
            <StoryComponent Contents="@(_recordToDisplay!.Fragment!.Content)"
                            ChapterName="@(_recordToDisplay!.Specification.Name)"
                            ChapterSubName="@(_recordToDisplay!.Specification.SubName)"
                            BackgroundDeriver="BackgroundFor"
            ></StoryComponent>
        </div>

    </div>
}

<div class="sundo-space-container">
    <div class="sundo-space-blur">

    </div>
    <div class="sundo-space-notes-container">
        @foreach(var part in Cache.Where(_ => _.Fragment != null)) 
        {
            <SpacePartNoteComponent Fragment="@(part.Fragment)" Specification="@(part.Specification)" OnPartSelected="OnNoteClicked"></SpacePartNoteComponent>
        }
    </div>
    <div class="sundo-space-refresh" @onclick="@(() => OnRefreshCache())">
    </div>
</div>

