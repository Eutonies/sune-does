@using Booktex.Domain.Book.Model
<div class="sundo-space-part-container-bg">
    <div class="sundo-space-part-container">
        @foreach(var part in _splitParts) 
        {
            <div 
                class="sundo-space-part-page" 
                style="left: @(part.Index * 100)px; z-index: @(ZIndexFor(part)); transform: rotate(@((-1 + part.Index))deg);"
                @onclick="@(() => OnPageClicked(part.Index))"
            >
            <div class="sundo-space-part-page-top-no">@(part.Index + 1)</div>
            <div class="sundo-space-part-focus @(FocusClassFor(part))"></div>
            <div class="sundo-space-part-content">
                    @if (part.Index == 0)
                    {
                        <div class="sundo-space-part-header">
                            <div class="sundo-space-part-header-name">@PartName</div>
                            @if (Specification.SubName != null)
                            {
                                <div class="sundo-space-part-header-sub-name">@PartSubName</div>
                            }
                        </div>
                    }
                    @foreach (var cont in part.Contents)
                    {
                        if (cont is BookCharacterLine lin)
                        {
                            <SpacePartCharacterLineComponent Line="lin" IsRight="false"></SpacePartCharacterLineComponent>
                        }
                        else if (cont is BookDialog diag)
                        {
                            foreach (var ent in diag.Entries)
                            {
                                <SpacePartCharacterLineComponent Line="ent.Line" IsRight="@(ent.LeftSide == null)"></SpacePartCharacterLineComponent>
                            }

                        }
                        else if (cont is BookNarration narr)
                        {
                            <div class="sundo-space-narration">@narr.NarrationContent</div>
                        }
                        else if (cont is BookContextBreak)
                        {
                            <div class="sundo-space-context-break"></div>
                        }
                        else if (cont is BookChapterSection sect)
                        {
                            <div class="sundo-space-section">
                                <div class="sundo-space-section-name">@(sect.Title)</div>
                            </div>
                        }
                        else if(cont is BookQuote quot) 
                        {
                            <SpacePartQuoteComponent Quote="quot"></SpacePartQuoteComponent>
                        }


                    }

            </div>
                <div class="sundo-space-part-page-bottom-no">@(part.Index + 1)</div>

            </div>
        }
    </div>
</div>