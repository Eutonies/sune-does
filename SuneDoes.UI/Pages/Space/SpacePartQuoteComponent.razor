@using Booktex.Domain.Book.Model
<div class="sundo-space-quote">
    <div class="sundo-space-quote-text">
        @foreach(var quotLin in Quote.QuoteString.Split('\n')) 
        {
            <div class="sundo-space-quote-text-line">@quotLin</div>
        }
    </div>
    @if(Quote.Name != null) 
    {
        <div class="sundo-space-quote-footer">
            <div class="sundo-space-quote-footer-name">@Quote.Name</div>
            @if(Quote.SubName != null) 
            {
                <div class="sundo-space-quote-footer-sub-name"> - @Quote.SubName</div>
            }
        </div>
    }
</div>
